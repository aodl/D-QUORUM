type Advance = record { step : Step; revision : nat64 };
type Effect = variant {
  Lock : nat64;
  Following : Following;
  Refresh;
  Dissolve;
  Visibility;
  Claim;
  Disburse;
};
type Following = record { topic : int32; followees : vec nat64 };
type Metadata = record { name : text; description : text; links : vec text };
type Network = variant { Ic; Local };
type Pending = record {
  dispatched_at : nat64;
  expected_return_e8s : opt nat64;
  step : Step;
  effect : opt Effect;
  revision : nat64;
  sequence : nat64;
};
type Phase = variant {
  RecoverableTestReady;
  AwaitingStake;
  AwaitingRegistration;
  Rehearsing;
  Configuring;
  AwaitingLock;
  Sealed;
  Recovering;
  Recovered;
};
type Plan = record {
  return_account : blob;
  dendrite_service : principal;
  managers : vec nat64;
  owner : principal;
  metadata : opt Metadata;
  committed_topics : vec int32;
  origin : text;
  network : Network;
  creation_id : blob;
  version : nat16;
  funding_budget_e8s : nat64;
  stake_e8s : nat64;
  nonce : nat64;
  lock_seconds : nat64;
  provision_cycles : nat64;
  policy_version : text;
  following : vec Following;
  policy_revision : text;
  revision : nat64;
  api_host : text;
  cycle_reserve : nat64;
  bootstrap_sha256 : blob;
  profile : Profile;
};
type Profile = variant { ProductionCandidate; RecoverableTest };
type Result = variant { Ok : State; Err : text };
type State = record {
  controller : principal;
  last_error : opt text;
  disbursement_block : opt nat64;
  plan_digest : blob;
  pending : opt Pending;
  plan : Plan;
  version : nat16;
  staking_subaccount : blob;
  phase : Phase;
  rehearsal_proposal : opt nat64;
  sequence : nat64;
  rehearsal_started_at : opt nat64;
  neuron_id : opt nat64;
};
type Step = variant {
  BeginRehearsal;
  Seal : nat64;
  Configure;
  StartDissolving;
  Unseal;
  Refresh;
  ReconcileDisbursement : nat64;
  CommitLock;
  Claim;
  Disburse;
};
service : (Plan) -> {
  advance : (Advance) -> (Result);
  replace_plan : (nat64, Plan) -> (Result);
  status : (nat64) -> (Result);
}