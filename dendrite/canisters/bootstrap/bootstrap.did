type Advance = record { step : Step; revision : nat64 };
type Effect = variant {
  Lock : nat64;
  Following : Following;
  Refresh;
  Dissolve;
  Visibility;
  Claim;
  Disburse;
};
type ExternalProposal = record {
  request_id : opt blob;
  kind : ProposalKind;
  dispatched : bool;
  created_at : nat64;
  proposal_id : opt nat64;
  proposer : nat64;
  request_digest : blob;
  revision : nat64;
  intent_id : blob;
};
type Following = record { topic : int32; followees : vec nat64 };
type Metadata = record { name : text; description : text; links : vec text };
type Network = variant { Ic; Local };
type Pending = record {
  dispatched_at : nat64;
  expected_return_e8s : opt nat64;
  step : Step;
  effect : opt Effect;
  expected_return_fee_e8s : opt nat64;
  revision : nat64;
  sequence : nat64;
};
type Phase = variant {
  RecoverableTestReady;
  AwaitingStake;
  AwaitingRegistration;
  Rehearsing;
  Configuring;
  AwaitingLock;
  Sealed;
  Recovering;
  Recovered;
};
type Plan = record {
  return_account : blob;
  icp_fee_e8s : nat64;
  dendrite_service : principal;
  managers : vec nat64;
  owner : principal;
  metadata : opt Metadata;
  committed_topics : vec int32;
  origin : text;
  network : Network;
  creation_id : blob;
  version : nat16;
  funding_budget_e8s : nat64;
  stake_e8s : nat64;
  nonce : nat64;
  lock_seconds : nat64;
  provision_cycles : nat64;
  policy_version : text;
  following : vec Following;
  policy_revision : text;
  revision : nat64;
  api_host : text;
  cycle_reserve : nat64;
  bootstrap_sha256 : blob;
  profile : Profile;
};
type Profile = variant { ProductionCandidate; RecoverableTest };
type ProposalKind = variant { Registration; Rehearsal };
type ProposalRefusalAudit = record {
  request_id : blob;
  reply_digest : blob;
  reservation : ExternalProposal;
  certificate_digest : blob;
  error_type : int32;
};
type ProposalRefusalProof = record {
  argument : blob;
  certificate : blob;
  ingress_expiry : nat64;
  nonce : opt blob;
  intent_id : blob;
};
type Result = variant { Ok : State; Err : text };
type State = record {
  controller : principal;
  last_error : opt text;
  disbursement_block : opt nat64;
  proposal_refusals : opt vec ProposalRefusalAudit;
  plan_digest : blob;
  pending : opt Pending;
  plan : Plan;
  public_visibility_confirmed : bool;
  version : nat16;
  external_proposal : opt ExternalProposal;
  sealed_controller_changes : opt nat64;
  staking_subaccount : blob;
  phase : Phase;
  module_binding : opt blob;
  rehearsal_proposal : opt nat64;
  sequence : nat64;
  rehearsal_started_at : opt nat64;
  neuron_id : opt nat64;
};
type Step = variant {
  MarkProposalDispatched : blob;
  ResolveProposal : nat64;
  CancelReservedProposal : blob;
  BeginRehearsal;
  Seal : nat64;
  Configure;
  StartDissolving;
  ReserveProposal : ExternalProposal;
  Unseal;
  ResolveProposalRefusal : ProposalRefusalProof;
  Refresh;
  ReconcileDisbursement : nat64;
  CommitLock;
  Claim;
  Disburse : record { expected_fee_e8s : nat64; expected_amount_e8s : nat64 };
};
service : (Plan) -> {
  advance : (Advance) -> (Result);
  replace_plan : (nat64, Plan) -> (Result);
  status : (nat64) -> (Result);
}