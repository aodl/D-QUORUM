type Account = record { owner : principal; subaccount : opt blob };
type Attempt = record {
  fee : nat64;
  memo : blob;
  may_have_executed : bool;
  number : nat32;
  created_at_time : nat64;
};
type Bootstrap = variant {
  Claiming;
  WaitingFunding;
  Inactive;
  Ready : nat64;
  Verifying : nat64;
};
type Candidate = record {
  id : nat64;
  managers : vec nat64;
  topics : vec int32;
  evaluator_commit : text;
  checked_at : nat64;
};
type CandidateResult = record {
  id : nat64;
  status : ComplianceStatus;
  admitted : opt Candidate;
  checked_at : nat64;
};
type Checkpoints = record {
  last_instructions : nat64;
  total_instructions : nat64;
  writes : nat64;
  mutations : nat64;
  bytes : nat64;
  maximum_instructions : nat64;
};
type ComplianceStatus = variant {
  Indeterminate;
  NonCompliant;
  StandardUpdateRequired;
  Compliant;
};
type Config = record {
  expected_target_controller : opt principal;
  mode : Mode;
  revision : nat64;
  delegates_per_topic : nat8;
};
type Configuration = record {
  score_scale : nat;
  bootstrap_staking_account : Account;
  reward_policy : text;
  target : nat64;
  evaluator_nns_source : text;
  ledger : principal;
  evaluator_commit : text;
  governance : principal;
  config : Config;
  policy_revision : text;
  bootstrap_nonce : nat64;
  protocol_commit : text;
};
type Destination = record {
  subaccount : blob;
  validated_at : nat64;
  neuron_id : nat64;
};
type Exclusion = record {
  shared_managers : vec nat64;
  selected_conflict : nat64;
  candidate : nat64;
};
type Health = record {
  pruned_unfinished_refreshes : nat64;
  stable_memory_pages : nat64;
  pending_refreshes : nat64;
  jobs : vec Job;
  staged_balance : opt nat64;
  bootstrap : Bootstrap;
  abandoned_refreshes : nat64;
  cycles : nat;
  checkpoints : Checkpoints;
  proposer : opt nat64;
  balance_observed_at : opt nat64;
  stable_snapshot_bytes : nat64;
};
type Init = record { expected_target_controller : opt principal; mode : Mode };
type Job = record {
  busy_until : nat64;
  failures : nat32;
  last_error : opt text;
  generation : nat64;
  measured_instructions : nat64;
  maximum_step_instructions : nat64;
  steps : nat64;
  next_at : nat64;
};
type Mode = variant { Live; ObserveOnly; BootstrapInactive };
type PayoutSummary = record {
  id : nat64;
  fee : nat64;
  roster_round : nat64;
  maintenance_complete : bool;
  recipient_count : nat32;
  dust : nat64;
  "reserved" : nat64;
  complete : bool;
  confirmed_count : nat32;
  confirmed_cost : nat;
  observed_balance : nat64;
  additional_fee_funding : nat64;
};
type ProposalJob = record {
  history_before : opt nat64;
  found : vec nat64;
  saw_disbursement : bool;
  retry_after : nat64;
  executed_at : opt nat64;
  receipt : opt record { nat64; nat64 };
  created_at : nat64;
  ledger_cursor : nat64;
  earliest_finalization : opt nat64;
  terminal_observed_at : opt nat64;
  operation : nat64;
  history_pages : nat64;
  fingerprint : blob;
  proposer : nat64;
  marker : text;
  phase : ProposalPhase;
};
type ProposalPhase = variant {
  Preflight;
  Failed : nat64;
  Open : nat64;
  TerminalExecutionVerified : nat64;
  Ambiguous;
  Rejected : nat64;
  Checking;
  Executed : nat64;
  AwaitingFinalization : nat64;
  FinalizedReceiptUnattributed : nat64;
  Adopted : nat64;
  Intent;
  CreationRejected : record { error_type : int32; reason : text };
};
type RefreshState = variant {
  Abandoned : record { reason : text };
  Complete;
  Waiting : record { reason : text };
  RetryAt : record { attempts : nat32; next_at : nat64; reason : text };
  Pending;
};
type Result = variant { Ok : nat64; Err : text };
type RosterView = record {
  planned_round : opt nat64;
  topic : int32;
  readback_observed_at : opt nat64;
  candidate_validated_at : opt nat64;
  applied : vec nat64;
  support_ended_at : opt nat64;
  support_started_at : opt nat64;
  planned : vec nat64;
  reconciled_at : opt nat64;
  reward_valid_until : opt nat64;
  intended_at : opt nat64;
  reward_eligible : bool;
  applied_round : opt nat64;
};
type ScanProgress = record {
  last_applied_scan : opt record { nat64; nat64 };
  failures : nat64;
  readback_observed_at : opt nat64;
  full_batches : nat64;
  candidate_validated_at : opt nat64;
  cursor : opt nat64;
  scan_ended_at : opt nat64;
  voting_context : opt VotingContext;
  evaluated_candidates : nat64;
  pages : nat64;
  phase : text;
  discovered_candidates : nat64;
  revision : opt nat64;
  last_failure : opt text;
  last_complete_scan : opt record { nat64; nat64 };
  round : opt nat64;
  started_at : opt nat64;
  intent_at : opt nat64;
  public_observations : nat64;
};
type Score = record {
  topic : int32;
  scaled_score : nat;
  complete : bool;
  neuron_id : nat64;
};
type Transfer = record {
  status : TransferStatus;
  destination : Destination;
  attempt : opt Attempt;
  memo : blob;
  history_cursor : nat64;
  rejected_attempts : vec Attempt;
  created_at_time : nat64;
  amount : nat64;
  refresh : opt RefreshState;
};
type TransferStatus = variant {
  Held : record { reason : text };
  Confirmed : record { block : nat64 };
  Prepared;
  Rejected : record { reason : text };
  Unknown : record { attempts : nat32 };
  Cooldown : record { until_ns : nat64; reason : text };
  Verifying : record { block : nat64 };
};
type VotingContext = record {
  parameters : opt VotingPowerEconomics;
  minimum_delay : nat64;
  resolution : text;
  governance_module : opt blob;
};
type VotingPowerEconomics = record {
  start_reducing_voting_power_after_seconds : opt nat64;
  neuron_minimum_dissolve_delay_to_vote_seconds : opt nat64;
  clear_following_after_seconds : opt nat64;
};
service : (opt Init) -> {
  candidate_page : (opt nat64, nat16) -> (vec CandidateResult) query;
  configuration : () -> (Configuration) query;
  exclusion_page : (int32, nat32, nat16) -> (vec Exclusion) query;
  health : () -> (Health) query;
  payout_page : (opt nat64, nat16) -> (vec PayoutSummary) query;
  proposal_progress : () -> (opt ProposalJob) query;
  roster_page : (nat16, nat16) -> (vec RosterView) query;
  scan_progress : () -> (ScanProgress) query;
  score_page : (opt record { int32; nat64 }, nat16) -> (vec Score) query;
  set_delegates_per_topic : (nat8) -> (Result);
  transfer_page : (nat64, nat32, nat16) -> (vec Transfer) query;
}